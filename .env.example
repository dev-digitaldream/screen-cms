# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
DATA_DIR=./server/data

# Session — MUST be changed per deployment
# Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-in-production

# Set to true when behind nginx / traefik / CapRover
TRUST_PROXY=true

# ── Admin account ─────────────────────────────────────────────────────────────
# Used ONCE to seed the database on first startup
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# ── Vite frontend ─────────────────────────────────────────────────────────────
VITE_API_BASE=/api/v1
VITE_APP_NAME=Screen Editor
VITE_DEFAULT_TIMEZONE=Europe/Paris
